// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`
//cat > ~/ithemba/prisma/schema.prisma << 'SCHEMA'
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model UserProfile {
  id        String   @id
  email     String   @unique
  fullName  String   @default("")
  clinicName           String?
  medicalLicenseNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient  Patient?
  provider Provider?

  roles          UserRole[]
  employerContact Employer?
  notificationPreference NotificationPreference?

  @@map("user_profiles")
}

model NotificationPreference {
  id            String      @id @default(uuid())
  userProfileId String      @unique
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  emailEnabled  Boolean     @default(true)
  smsEnabled    Boolean     @default(true)
  reminderAdvanceHours Int  @default(24)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@map("notification_preferences")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userProfileId String
  roleId        String
  assignedAt    DateTime    @default(now())
  assignedBy    String?
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userProfileId, roleId])
  @@map("user_roles")
}

model Patient {
  id             String      @id @default(uuid())
  userProfileId  String      @unique
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  phoneNumber    String      @default("")
  nationalId     String
  dateOfBirth    DateTime?
  address        String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  lastModifiedBy String?
  appointments        Appointment[]
  beneficiaries       Beneficiary[]
  savingsAccount      HealthSavingsAccount?
  feedback            UserFeedback[]
  supportTickets      SupportTicket[]
  employerMemberships EmployerMembership[]
  @@map("patients")
}

model Provider {
  id                   String      @id @default(uuid())
  userProfileId        String      @unique
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  firstName            String      @default("")
  lastName             String      @default("")
  clinicName           String      @default("")
  medicalLicenseNumber String?
  specialization       String      @default("")
  phoneNumber          String      @default("")
  email                String      @default("")
  about                String?
  location             String      @default("")
  mpesaMerchantCode    String      @default("")
  bankAccountNumber    String?
  bankName             String?
  ecocashNumber        String?
  disbursementEnabled  Boolean     @default(false)
  isActive             Boolean     @default(true)
  isVerified           Boolean     @default(false)
  wso2OrganizationId   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  lastModifiedBy       String?
  specializations Specialization[]
  qualifications  Qualification[]
  workingHours    WorkingHours[]
  addresses       ProviderAddress[]
  timeOff         ProviderTimeOff[]
  appointments    Appointment[]
  providerClaims  ProviderClaim[]
  @@map("providers")
}

model Specialization {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  @@map("specializations")
}

model Qualification {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  @@map("qualifications")
}

model WorkingHours {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  @@map("working_hours")
}

model ProviderAddress {
  id           String      @id @default(uuid())
  providerId   String
  provider     Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  addressType  AddressType @default(Physical)
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  country      String      @default("Lesotho")
  postalCode   String?
  latitude     Float?
  longitude    Float?
  isPrimary    Boolean     @default(false)
  @@map("provider_addresses")
}

model ProviderTimeOff {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startUtc   DateTime
  endUtc     DateTime
  reason     String?
  createdAt  DateTime @default(now())
  @@map("provider_time_off")
}

enum AddressType {
  Physical
  Postal
}

model Beneficiary {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId         String?
  fullName       String
  dateOfBirth    DateTime?
  relationship   String
  gender         String?
  nationalId     String?
  phoneNumber    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  lastModifiedBy String?
  appointments   Appointment[]
  @@map("beneficiaries")
}

model Appointment {
  id                  String            @id @default(uuid())
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id])
  providerId          String
  provider            Provider          @relation(fields: [providerId], references: [id])
  beneficiaryId       String?
  beneficiary         Beneficiary?      @relation(fields: [beneficiaryId], references: [id])
  startUtc            DateTime
  endUtc              DateTime
  visitCode           String?
  reason              String?
  status              AppointmentStatus @default(Requested)
  isConfirmedByClinic Boolean           @default(false)
  confirmedAtUtc      DateTime?
  confirmedByUserId   String?
  checkedInAtUtc      DateTime?
  completedAtUtc      DateTime?
  cancelledAtUtc      DateTime?
  cancellationReason  String?
  cancelledByUserId   String?
  advanceReminderSentAt DateTime?
  finalReminderSentAt   DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String?
  lastModifiedBy      String?
  notes         AppointmentNote[]
  otps          AppointmentOTP[]
  statusHistory AppointmentStatusChange[]
  claim         ProviderClaim?
  // A partial unique index on (providerId, startUtc), excluding cancelled/no-show
  // statuses, is applied via raw migration (20260713150000) — not representable
  // in this DSL. It backs the double-booking guard in appointments.service.ts.
  @@map("appointments")
}

enum AppointmentStatus {
  Requested
  Scheduled
  Confirmed
  CheckedIn
  InProgress
  Completed
  CancelledByPatient
  CancelledByProvider
  NoShow
  Rescheduled
}

model AppointmentNote {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  note          String
  addedBy       String
  isAdminNote   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  @@map("appointment_notes")
}

model AppointmentOTP {
  id              String      @id @default(uuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  code            String
  expiresAtUtc    DateTime
  sentAtUtc       DateTime    @default(now())
  isUsed          Boolean     @default(false)
  usedAtUtc       DateTime?
  deliveryChannel String?
  destination     String?
  createdAt       DateTime    @default(now())
  @@map("appointment_otps")
}

model AppointmentStatusChange {
  id              String            @id @default(uuid())
  appointmentId   String
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus      AppointmentStatus
  toStatus        AppointmentStatus
  changedAtUtc    DateTime          @default(now())
  reason          String?
  changedByUserId String?
  @@map("appointment_status_changes")
}

model HealthSavingsAccount {
  id                     String    @id @default(uuid())
  patientId              String    @unique
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name                   String?
  currency               String    @default("ZAR")
  balance                Decimal   @default(0) @db.Decimal(12, 2)
  totalContributed       Decimal   @default(0) @db.Decimal(12, 2)
  totalClaimed           Decimal   @default(0) @db.Decimal(12, 2)
  isDefault              Boolean   @default(true)
  autoDebitEnabled       Boolean   @default(false)
  debitSourceMpesaNumber String?
  lastLowBalanceNotifiedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?
  lastModifiedBy         String?
  transactions   SavingsTransaction[]
  providerClaims ProviderClaim[]
  autoDebitSetup AutoDebitSetup?
  @@map("health_savings_accounts")
}

model SavingsTransaction {
  id                   String                 @id @default(uuid())
  accountId            String
  account              HealthSavingsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patientId            String
  transactionType      SavingsTransactionType
  amount               Decimal                @db.Decimal(12, 2)
  transactionDate      DateTime               @default(now())
  mpesaTransactionCode String?
  notes                String?
  message              String?
  idempotencyKey       String?
  failureReason        String?
  isSuccessful         Boolean                @default(true)
  status               PaymentStatus          @default(Succeeded)
  golinkPaymentId      String?                @unique
  linkedClaims         ProviderClaim[]
  @@map("savings_transactions")
}

enum SavingsTransactionType {
  Deposit
  Debit
  ClaimPayment
  TransferIn
  TransferOut
  EmployerContribution
  AdminAdjustment
}

enum PaymentStatus {
  Pending
  Processing
  Succeeded
  Failed
}

model AutoDebitSetup {
  id              String               @id @default(uuid())
  accountId       String               @unique
  account         HealthSavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mpesaNumber     String
  amount          Decimal              @db.Decimal(12, 2)
  frequency       DebitFrequency
  nextDebitDate   DateTime
  isActive        Boolean              @default(true)
  golinkMandateId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  @@map("auto_debit_setups")
}

enum DebitFrequency {
  Weekly
  Monthly
}

model ProviderClaim {
  id                    String               @id @default(uuid())
  claimNumber           String?
  accountId             String
  account               HealthSavingsAccount @relation(fields: [accountId], references: [id])
  providerId            String
  provider              Provider             @relation(fields: [providerId], references: [id])
  appointmentId         String?              @unique
  appointment           Appointment?         @relation(fields: [appointmentId], references: [id])
  linkedTransactionId   String?
  linkedTransaction     SavingsTransaction?  @relation(fields: [linkedTransactionId], references: [id])
  dateOfVisit           DateTime
  totalAmount           Decimal              @db.Decimal(12, 2)
  hsaCoveredAmount      Decimal              @db.Decimal(12, 2) @default(0)
  outOfPocketAmount     Decimal              @db.Decimal(12, 2) @default(0)
  currency              String               @default("ZAR")
  description           String?
  status                ClaimStatus          @default(Pending)
  attachmentUrl         String?
  beneficiaryName       String?
  relationshipToPatient String?
  decisionTimestamp     DateTime?
  approvedBy            String?
  adminNotes            String?
  doctorNotes           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String?
  lastModifiedBy        String?
  attachments  ClaimAttachment[]
  decisions    ClaimDecision[]
  adminActions AdminClaimAction[]
  lineItems    ClaimLineItem[]
  @@map("provider_claims")
}

enum ClaimStatus {
  Pending
  Submitted
  InReview
  Approved
  Rejected
  Paid
  Denied
  Withdrawn
}

model ClaimLineItem {
  id          String        @id @default(uuid())
  claimId     String
  claim       ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  @@map("claim_line_items")
}

model ClaimAttachment {
  id         String        @id @default(uuid())
  claimId    String
  claim      ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  url        String
  fileName   String
  mimeType   String?
  uploadedAt DateTime      @default(now())
  @@map("claim_attachments")
}

model ClaimDecision {
  id        String        @id @default(uuid())
  claimId   String
  claim     ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decidedBy String
  decision  ClaimStatus
  notes     String?
  decidedAt DateTime      @default(now())
  @@map("claim_decisions")
}

model AdminClaimAction {
  id        String        @id @default(uuid())
  claimId   String
  claim     ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  adminId   String
  action    String
  note      String?
  createdAt DateTime      @default(now())
  @@map("admin_claim_actions")
}

model PaymentPayout {
  id             String       @id @default(uuid())
  providerId     String
  claimId        String?      @unique
  amount         Decimal      @db.Decimal(12, 2)
  method         String
  reference      String?
  idempotencyKey String?      @unique
  failureReason  String?
  status         PayoutStatus @default(Pending)
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  @@map("payment_payouts")
}

enum PayoutStatus {
  Pending
  Processing
  Completed
  Failed
}

model SupportTicket {
  id          String       @id @default(uuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  subject     String
  description String
  status      TicketStatus @default(Open)
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@map("support_tickets")
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model UserFeedback {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  rating    Int
  comment   String?
  context   String?
  createdAt DateTime @default(now())
  @@map("user_feedback")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  @@map("system_settings")
}

model AuditLogEntry {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@map("audit_log_entries")
}

model PendingRegistration {
  id            String   @id @default(uuid())
  email         String
  phoneNumber   String
  firstName     String
  lastName      String
  role          String   // PATIENT | PROVIDER | EMPLOYER
  companyName   String?  // EMPLOYER registrations only
  emailOtpHash  String
  phoneOtpHash  String
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@map("pending_registrations")
}

model PasswordResetRequest {
  id            String   @id @default(uuid())
  userProfileId String
  emailOtpHash  String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@map("password_reset_requests")
}

// ─── Corporate Employer Group Plans ─────────────────────────────────────────

model Employer {
  id                   String    @id @default(uuid())
  name                 String
  registrationNumber   String?
  contactName          String
  contactEmail         String
  contactPhone         String
  contactUserProfileId String?   @unique
  contactUser          UserProfile? @relation(fields: [contactUserProfileId], references: [id])
  platformFeePerSeat   Decimal   @default(50) @db.Decimal(10, 2)
  isActive             Boolean   @default(true)
  isVerified           Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?
  wso2OrganizationId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?

  memberships   EmployerMembership[]
  billingCycles EmployerBillingCycle[]
  invites       EmployerInvite[]

  @@map("employers")
}

model EmployerInvite {
  id                 String               @id @default(uuid())
  employerId         String
  employer           Employer             @relation(fields: [employerId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  email              String
  phoneNumber        String
  employeeRef        String
  contributionAmount Decimal              @db.Decimal(10, 2)
  status             EmployerInviteStatus @default(Pending)
  token              String               @unique @default(uuid())
  expiresAt          DateTime
  acceptedAt         DateTime?
  patientId          String?
  createdAt          DateTime             @default(now())
  createdBy          String?

  @@unique([employerId, employeeRef])
  @@map("employer_invites")
}

enum EmployerInviteStatus {
  Pending
  Accepted
  Expired
  Cancelled
}

model EmployerMembership {
  id                 String                 @id @default(uuid())
  employerId         String
  employer           Employer               @relation(fields: [employerId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient                @relation(fields: [patientId], references: [id])
  employeeRef        String
  contributionAmount Decimal                @db.Decimal(10, 2)
  status             EmployerMemberStatus   @default(Active)
  startDate          DateTime               @default(now())
  endDate            DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdBy          String?

  lineItems EmployerBillingLineItem[]

  @@unique([employerId, patientId])
  @@unique([employerId, employeeRef])
  @@map("employer_memberships")
}

enum EmployerMemberStatus {
  Active
  Suspended
  Terminated
}

model EmployerBillingCycle {
  id              String                @id @default(uuid())
  employerId      String
  employer        Employer              @relation(fields: [employerId], references: [id], onDelete: Cascade)
  billingMonth    String
  invoiceNumber   String                @unique
  invoiceDate     DateTime              @default(now())
  dueDate         DateTime
  employeeCount   Int
  subtotal        Decimal               @db.Decimal(12, 2)
  platformFee     Decimal               @db.Decimal(12, 2)
  totalAmount     Decimal               @db.Decimal(12, 2)
  paymentMethod   EmployerPaymentMethod @default(Manual)
  golinkPaymentLink String?
  golinkTransactionId String? @unique
  status          BillingCycleStatus    @default(Draft)
  invoicedAt      DateTime?
  paidAt          DateTime?
  confirmedBy     String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  lineItems EmployerBillingLineItem[]

  @@unique([employerId, billingMonth])
  @@map("employer_billing_cycles")
}

enum EmployerPaymentMethod {
  Manual
  Mpesa
  EcoCash
  Card
  EFT
  PaymentLink
  Payslip
}

enum BillingCycleStatus {
  Draft
  Invoiced
  AwaitingPayment
  Paid
  Overdue
  Failed
}

model EmployerBillingLineItem {
  id                 String               @id @default(uuid())
  billingCycleId     String
  billingCycle       EmployerBillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  membershipId       String
  membership         EmployerMembership   @relation(fields: [membershipId], references: [id])
  patientId          String
  employeeName       String
  employeeRef        String
  contributionAmount Decimal              @db.Decimal(10, 2)
  hsaCredited        Boolean              @default(false)
  hsaCreditedAt      DateTime?

  @@unique([billingCycleId, membershipId])
  @@map("employer_billing_line_items")
}
