// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`
//cat > ~/ithemba/prisma/schema.prisma << 'SCHEMA'
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model UserProfile {
  id        String   @id
  email     String   @unique
  fullName  String   @default("")
  clinicName           String?
  medicalLicenseNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient  Patient?
  provider Provider?

  roles UserRole[]

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userProfileId String
  roleId        String
  assignedAt    DateTime    @default(now())
  assignedBy    String?
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userProfileId, roleId])
  @@map("user_roles")
}

model Patient {
  id             String      @id @default(uuid())
  userProfileId  String      @unique
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  phoneNumber    String      @default("")
  nationalId     String?
  dateOfBirth    DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  lastModifiedBy String?
  appointments   Appointment[]
  beneficiaries  Beneficiary[]
  savingsAccount HealthSavingsAccount?
  feedback       UserFeedback[]
  supportTickets SupportTicket[]
  @@map("patients")
}

model Provider {
  id                   String      @id @default(uuid())
  userProfileId        String      @unique
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  firstName            String      @default("")
  lastName             String      @default("")
  clinicName           String      @default("")
  medicalLicenseNumber String?
  specialization       String      @default("")
  phoneNumber          String      @default("")
  email                String      @default("")
  about                String?
  location             String      @default("")
  mpesaMerchantCode    String      @default("")
  bankAccountNumber    String?
  bankName             String?
  isActive             Boolean     @default(true)
  isVerified           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  lastModifiedBy       String?
  specializations Specialization[]
  qualifications  Qualification[]
  workingHours    WorkingHours[]
  addresses       ProviderAddress[]
  timeOff         ProviderTimeOff[]
  appointments    Appointment[]
  providerClaims  ProviderClaim[]
  @@map("providers")
}

model Specialization {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  @@map("specializations")
}

model Qualification {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  @@map("qualifications")
}

model WorkingHours {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  @@map("working_hours")
}

model ProviderAddress {
  id           String      @id @default(uuid())
  providerId   String
  provider     Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  addressType  AddressType @default(Physical)
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  country      String      @default("Lesotho")
  postalCode   String?
  latitude     Float?
  longitude    Float?
  isPrimary    Boolean     @default(false)
  @@map("provider_addresses")
}

model ProviderTimeOff {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startUtc   DateTime
  endUtc     DateTime
  reason     String?
  createdAt  DateTime @default(now())
  @@map("provider_time_off")
}

enum AddressType {
  Physical
  Postal
}

model Beneficiary {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId         String?
  fullName       String
  dateOfBirth    DateTime?
  relationship   String
  gender         String?
  nationalId     String?
  phoneNumber    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  lastModifiedBy String?
  appointments   Appointment[]
  @@map("beneficiaries")
}

model Appointment {
  id                  String            @id @default(uuid())
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id])
  providerId          String
  provider            Provider          @relation(fields: [providerId], references: [id])
  beneficiaryId       String?
  beneficiary         Beneficiary?      @relation(fields: [beneficiaryId], references: [id])
  startUtc            DateTime
  endUtc              DateTime
  reason              String?
  status              AppointmentStatus @default(Requested)
  isConfirmedByClinic Boolean           @default(false)
  confirmedAtUtc      DateTime?
  confirmedByUserId   String?
  checkedInAtUtc      DateTime?
  completedAtUtc      DateTime?
  cancelledAtUtc      DateTime?
  cancellationReason  String?
  cancelledByUserId   String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String?
  lastModifiedBy      String?
  notes         AppointmentNote[]
  otps          AppointmentOTP[]
  statusHistory AppointmentStatusChange[]
  claim         ProviderClaim?
  @@map("appointments")
}

enum AppointmentStatus {
  Requested
  Scheduled
  Confirmed
  CheckedIn
  InProgress
  Completed
  CancelledByPatient
  CancelledByProvider
  NoShow
  Rescheduled
}

model AppointmentNote {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  note          String
  addedBy       String
  isAdminNote   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  @@map("appointment_notes")
}

model AppointmentOTP {
  id              String      @id @default(uuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  code            String
  expiresAtUtc    DateTime
  sentAtUtc       DateTime    @default(now())
  isUsed          Boolean     @default(false)
  usedAtUtc       DateTime?
  deliveryChannel String?
  destination     String?
  createdAt       DateTime    @default(now())
  @@map("appointment_otps")
}

model AppointmentStatusChange {
  id              String            @id @default(uuid())
  appointmentId   String
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus      AppointmentStatus
  toStatus        AppointmentStatus
  changedAtUtc    DateTime          @default(now())
  reason          String?
  changedByUserId String?
  @@map("appointment_status_changes")
}

model HealthSavingsAccount {
  id                     String    @id @default(uuid())
  patientId              String    @unique
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name                   String?
  currency               String    @default("ZAR")
  balance                Decimal   @default(0) @db.Decimal(12, 2)
  totalContributed       Decimal   @default(0) @db.Decimal(12, 2)
  totalClaimed           Decimal   @default(0) @db.Decimal(12, 2)
  isDefault              Boolean   @default(true)
  autoDebitEnabled       Boolean   @default(false)
  debitSourceMpesaNumber String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?
  lastModifiedBy         String?
  transactions   SavingsTransaction[]
  providerClaims ProviderClaim[]
  autoDebitSetup AutoDebitSetup?
  @@map("health_savings_accounts")
}

model SavingsTransaction {
  id                   String                 @id @default(uuid())
  accountId            String
  account              HealthSavingsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  patientId            String
  transactionType      SavingsTransactionType
  amount               Decimal                @db.Decimal(12, 2)
  transactionDate      DateTime               @default(now())
  mpesaTransactionCode String?
  notes                String?
  message              String?
  idempotencyKey       String?
  failureReason        String?
  isSuccessful         Boolean                @default(true)
  linkedClaims         ProviderClaim[]
  @@map("savings_transactions")
}

enum SavingsTransactionType {
  Deposit
  Debit
  ClaimPayment
  TransferIn
  TransferOut
}

model AutoDebitSetup {
  id            String               @id @default(uuid())
  accountId     String               @unique
  account       HealthSavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mpesaNumber   String
  amount        Decimal              @db.Decimal(12, 2)
  frequency     DebitFrequency
  nextDebitDate DateTime
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@map("auto_debit_setups")
}

enum DebitFrequency {
  Weekly
  Monthly
}

model ProviderClaim {
  id                    String               @id @default(uuid())
  claimNumber           String?
  accountId             String
  account               HealthSavingsAccount @relation(fields: [accountId], references: [id])
  providerId            String
  provider              Provider             @relation(fields: [providerId], references: [id])
  appointmentId         String?              @unique
  appointment           Appointment?         @relation(fields: [appointmentId], references: [id])
  linkedTransactionId   String?
  linkedTransaction     SavingsTransaction?  @relation(fields: [linkedTransactionId], references: [id])
  dateOfVisit           DateTime
  totalAmount           Decimal              @db.Decimal(12, 2)
  currency              String               @default("ZAR")
  description           String?
  status                ClaimStatus          @default(Pending)
  attachmentUrl         String?
  beneficiaryName       String?
  relationshipToPatient String?
  decisionTimestamp     DateTime?
  approvedBy            String?
  adminNotes            String?
  doctorNotes           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String?
  lastModifiedBy        String?
  attachments  ClaimAttachment[]
  decisions    ClaimDecision[]
  adminActions AdminClaimAction[]
  @@map("provider_claims")
}

enum ClaimStatus {
  Pending
  Submitted
  InReview
  Approved
  Rejected
  Paid
  Denied
}

model ClaimAttachment {
  id         String        @id @default(uuid())
  claimId    String
  claim      ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  url        String
  fileName   String
  mimeType   String?
  uploadedAt DateTime      @default(now())
  @@map("claim_attachments")
}

model ClaimDecision {
  id        String        @id @default(uuid())
  claimId   String
  claim     ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  decidedBy String
  decision  ClaimStatus
  notes     String?
  decidedAt DateTime      @default(now())
  @@map("claim_decisions")
}

model AdminClaimAction {
  id        String        @id @default(uuid())
  claimId   String
  claim     ProviderClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  adminId   String
  action    String
  note      String?
  createdAt DateTime      @default(now())
  @@map("admin_claim_actions")
}

model PaymentPayout {
  id          String       @id @default(uuid())
  providerId  String
  amount      Decimal      @db.Decimal(12, 2)
  method      String
  reference   String?
  status      PayoutStatus @default(Pending)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  @@map("payment_payouts")
}

enum PayoutStatus {
  Pending
  Processing
  Completed
  Failed
}

model SupportTicket {
  id          String       @id @default(uuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  subject     String
  description String
  status      TicketStatus @default(Open)
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@map("support_tickets")
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model UserFeedback {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  rating    Int
  comment   String?
  context   String?
  createdAt DateTime @default(now())
  @@map("user_feedback")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  @@map("system_settings")
}

model AuditLogEntry {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@map("audit_log_entries")
}