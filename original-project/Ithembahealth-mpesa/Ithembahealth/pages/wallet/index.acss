/* ===== Brand palette (light blue primary) ===== */
:root {
  --ih-primary: #23b0d3;         /* light blue primary */
  --ih-primary-strong: #1a8aa8;  /* deeper blue */
  --ih-primary-soft: #e0f6fc;    /* pale blue background */

  --ih-secondary: #66905e;       /* secondary (muted green) */

  /* Structure */
  --ih-bg: #f3f4f6;
  --ih-card-bg: #ffffff;
  --ih-border-soft: #e5e7eb;

  /* Text */
  --ih-text-main: #0f172a;
  --ih-text-muted: #6b7280;
  --ih-text-soft: #9ca3af;

  /* Status */
  --ih-success: #22c55e;
  --ih-danger: #b91c1c;
}

/* ===== Layout ===== */
.page-wrap {
  padding: 24rpx;
  background: var(--ih-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.section-gap {
  margin-top: 24rpx;
}

/* ===== Cards ===== */
.card {
  background: var(--ih-card-bg);
  border-radius: 16rpx;
  border: 1rpx solid var(--ih-border-soft);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
  padding: 24rpx;
}

/* ===== Summary header (Balance / Savings etc.) ===== */
.summary {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 24rpx;
}

/* Stack label / value / meta on top of each other */
.summary .stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, var(--ih-primary), #4fd3f5);
  color: #ecfeff;
  box-shadow: 0 10rpx 24rpx rgba(35, 176, 211, 0.35);

  display: flex;
  flex-direction: column;   /* children stacked vertically */
  align-items: flex-start;  /* left align */
  gap: 6rpx;                /* spacing between lines */
}

.summary .label,
.summary .value,
.summary .meta {
  display: block;
  line-height: 1.4;
}

.summary .label {
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.9;
}

.summary .value {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.summary .meta {
  margin-top: 2rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

/* ===== Top-up area (if present on page) ===== */
.topup {
  margin-top: 24rpx;
}

.topup .row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.topup .input,
.topup input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--ih-border-soft);
  font-size: 26rpx;
  color: var(--ih-text-main);
  background: #f9fafb;
  box-sizing: border-box;
}

.topup .input::placeholder,
.topup input::placeholder {
  color: var(--ih-text-soft);
}

.topup .actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* ===== Buttons ===== */
.btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--ih-primary);
  border-color: var(--ih-primary);
  color: #ffffff;
}

.btn-primary:active {
  background: var(--ih-primary-strong);
  border-color: var(--ih-primary-strong);
}

.btn-outline {
  background: transparent;
  border-color: var(--ih-primary);
  color: var(--ih-primary);
}

.btn-outline:active {
  background: var(--ih-primary-soft);
}

/* ===== Error block ===== */
.error {
  border-left: 6rpx solid var(--ih-danger);
  background: #fef2f2;
  color: #b91c1c;
  font-size: 24rpx;
}

/* ===== History / list card (shared) ===== */
.history .section-title,
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ih-text-main);
  margin-bottom: 16rpx;
}

.history .empty {
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ih-text-soft);
}

/* ===== Generic stacked item list (transactions, etc.) ===== */
.tx-list {
  margin-top: 8rpx;
}

.tx {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--ih-border-soft);
}

.tx:last-child {
  border-bottom-width: 0;
}

/* Left side: title + subtext stacked */
.tx .left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tx .title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ih-text-main);
  line-height: 1.4;
}

.tx .sub {
  font-size: 22rpx;
  color: var(--ih-text-muted);
  line-height: 1.4;
}

/* Right side: amount + status stacked */
.tx .right {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.tx .amt {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.tx .amt.credit {
  color: var(--ih-secondary);
}

.tx .amt.debit {
  color: var(--ih-danger);
}

.tx .status {
  font-size: 22rpx;
  color: var(--ih-text-soft);
  line-height: 1.4;
}

/* ===== Load more hint ===== */
.loadmore {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ih-text-soft);
}

/* ===== Utilities ===== */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-12 { margin-bottom: 12rpx; }
.text-right { text-align: right; }
.muted { color: var(--ih-text-soft); }

/* ===== Dark mode (optional) ===== */
@media (prefers-color-scheme: dark) {
  .page-wrap {
    background: #020617;
  }

  .card,
  .tx-list,
  .topup {
    background: #020617;
    border-color: #1e293b;
    box-shadow: none;
  }

  .summary .stat {
    background: linear-gradient(145deg, #0f3f52, var(--ih-primary));
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.6);
  }

  .summary .value,
  .tx .title {
    color: #e5e7eb;
  }

  .summary .label,
  .summary .meta,
  .tx .sub,
  .loadmore,
  .muted {
    color: #9ca3af;
  }

  .topup .input,
  .topup input {
    background: #020617;
    border-color: #1e293b;
    color: #e5e7eb;
  }

  .btn-primary {
    background: var(--ih-primary);
    border-color: var(--ih-primary);
  }

  .btn-outline {
    border-color: var(--ih-primary);
    color: #bae6fd;
  }
}
/* ===== Fee Badge ===== */
.fee-tag {
  color: #ff9800;
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.9;
}

/* Notes under title */
.note {
  color: var(--ih-text-muted);
  font-size: 22rpx;
}

/* Cleaner date style */
.date {
  color: var(--ih-text-soft);
  font-size: 22rpx;
}

/* Already have amt.credit / amt.debit, but boost weight */
.tx .amt.credit {
  color: var(--ih-success);
  font-weight: 700;
}

.tx .amt.debit {
  color: var(--ih-danger);
  font-weight: 700;
}
.title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.fee-tag {
  margin-left: 8rpx;
  color: #ff9800;
  font-size: 22rpx;
  font-weight: 600;
}

.note, .date {
  display: block;
}
