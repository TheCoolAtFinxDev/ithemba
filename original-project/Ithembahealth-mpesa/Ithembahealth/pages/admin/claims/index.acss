/* pages/admin/claims/index.acss */
.page {
  padding: 16rpx;
  background-color: #f5f7fb;
  min-height: 100vh;
}

.header {
  margin-bottom: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.banner.error {
  background-color: #ffe4e4;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.b-title {
  font-weight: 600;
  color: #b00020;
}

.b-msg {
  display: block;
  color: #b00020;
  margin-top: 4rpx;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ccd5e5;
  background-color: #ffffff;
  font-size: 24rpx;
  color: #555;
}

.pill--active {
  border-color: #23b0d3;
  background-color: #e5f7fb;
  color: #23b0d3;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.status {
  font-size: 24rpx;
}

/* Status colors */
.st-submitted {
  color: #ff9800;
}

.st-approved {
  color: #4caf50;
}

.st-paid {
  color: #00796b;
}

.st-rejected {
  color: #d32f2f;
}

.st-unknown {
  color: #888;
}

.line {
  font-size: 24rpx;
  color: #555;
}

.line.small {
  font-size: 22rpx;
  color: #777;
}

.loading, .empty {
  text-align: center;
  margin-top: 48rpx;
  color: #777;
}
