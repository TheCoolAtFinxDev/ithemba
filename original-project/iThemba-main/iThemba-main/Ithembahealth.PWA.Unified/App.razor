@using Ithembahealth.PWA.Unified.Services
@inject IUpdateService UpdateService
@inject NetworkService Net
@inject NavigationManager Nav

<ErrorBoundary>
    <ChildContent>
        <CascadingAuthenticationState>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            <Ithembahealth.PWA.Unified.Shared.Components.RedirectToLogin />
                        </NotAuthorized>
                        <Authorizing>
                            <p class="px-4"></p>
                        </Authorizing>
                    </AuthorizeRouteView>
                </Found>
                <NotFound>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <p class="px-4">Sorry, there's nothing at this address.</p>
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </ChildContent>
    <ErrorContent Context="ex">
        <MudAlert Severity="Severity.Error" Elevation="1" Dense="true" Class="m-2">
            Oops — something broke. 
            <MudButton OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad:true))" Variant="Variant.Text">
                Reload
            </MudButton>
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>


@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateService.InitializeAsync(this);
            await Net.InitializeAsync();

        }
    }
}