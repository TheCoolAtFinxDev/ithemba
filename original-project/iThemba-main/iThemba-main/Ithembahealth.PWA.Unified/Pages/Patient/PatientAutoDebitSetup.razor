@page "/patient/savings/auto-debit"
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Patient")]

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudText Typo="Typo.h5" Class="mb-2">Auto-Debit Setup</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1">Fund Your IThemba Health Savings</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            You can add funds from your M-PESA account through the app or by visiting a registered M-PESA merchant. Funds reflect instantly in your savings balance.
        </MudText>

        <MudSwitch T="bool" @bind-Checked="_autoDebitEnabled" Color="Color.Primary" Class="mb-3">
            Enable Auto-Debit from M-PESA
        </MudSwitch>

        <MudForm Disabled="@(!_autoDebitEnabled)">
            <MudText Typo="Typo.body2" Class="mb-2">Choose a preset or enter a custom amount:</MudText>

            <MudChipSet T="string" @bind-SelectedChip="_selectedAmount" Class="mb-3">
                <MudChip OnClick="@(() => ToggleChipSelection("500"))" Value="500" Class="@HighlightChip("500")">LSL 500</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("1000"))" Value="1000" Class="@HighlightChip("1000")">LSL 1000</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("2500"))" Value="2500" Class="@HighlightChip("2500")">LSL 2500</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("5000"))" Value="5000" Class="@HighlightChip("5000")">LSL 5000</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("10000"))" Value="10000" Class="@HighlightChip("10000")">LSL 10 000</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("25000"))" Value="25000" Class="@HighlightChip("25000")" Disabled="@(_frequency == "Monthly")">LSL 25 000</MudChip>
                <MudChip OnClick="@(() => ToggleChipSelection("50000"))" Value="50000" Class="@HighlightChip("50000")" Disabled="@(_frequency == "Monthly")">LSL 50 000</MudChip>
            </MudChipSet>

            <MudTextField Label="Or Enter Custom Amount (LSL)"
                          Variant="Variant.Outlined"
                          @bind-Value="_debitAmount"
                          Immediate="true"
                          Class="mb-3"
                          Adornment="Adornment.End"
                          AdornmentText="LSL"
                          OnBlur="ValidateAmount" />

            @if (!string.IsNullOrWhiteSpace(_amountWarning))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_amountWarning</MudAlert>
            }

            <MudSelect T="string" Label="Frequency" @bind-Value="_frequency" Class="mb-3" OnValueChanged="OnFrequencyChanged">
                <MudSelectItem Value='@("Monthly")'>Monthly</MudSelectItem>
                <MudSelectItem Value='@("Weekly")'>Weekly</MudSelectItem>
            </MudSelect>

            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAutoDebitSettings">
                Save Settings
            </MudButton>
        </MudForm>
    </MudPaper>
@*     <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1">Submit a Claim</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Submit a medical claim for yourself or a registered beneficiary.
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ReceiptLong"
                   OnClick="@(() => NavigationManager.NavigateTo("/savings/claims"))">
            Submit Claim
        </MudButton>
    </MudPaper>
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.subtitle2">How Claims Work</MudText>
        <MudText Typo="Typo.body2">
            Claims can be submitted for yourself and your dependents through the M-PESA app.
            When a claim is submitted, a one-time password (OTP) will be sent to your registered number.
            You must approve the payment using this OTP in the M-PESA app. Balances reflect instantly after approval.
        </MudText>
    </MudPaper> *@
</MudContainer>

@code {
    private bool _autoDebitEnabled = true;
    private string _debitAmount = string.Empty;
    private string _frequency = "Monthly";
    private string? _selectedAmount;
    private string? _amountWarning;

    private void OnPresetAmountChanged(string value)
    {
        if (_selectedAmount == value)
        {
            _selectedAmount = null;
            _debitAmount = string.Empty;
        }
        else
        {
            _selectedAmount = value;
            _debitAmount = value;
        }
        ValidateAmount();
    }

    private void OnFrequencyChanged(string freq)
    {
        _frequency = freq;
        ValidateAmount();
    }

    private string HighlightChip(string value) =>
        _selectedAmount == value ? "mud-chip-selected" : "";

    private void ValidateAmount()
    {
        if (!string.IsNullOrEmpty(_selectedAmount))
            _debitAmount = _selectedAmount;

        if (decimal.TryParse(_debitAmount, out var amount))
        {
            if (_frequency == "Monthly" && (amount < 500 || amount > 10000))
                _amountWarning = "Monthly debit must be between LSL 500 and LSL 10 000.";
            else if (amount >= 50000)
                _amountWarning = "Lump sum deposits of LSL 50 000 and above are subject to AML audits.";
            else
                _amountWarning = null;
        }
        else
        {
            _amountWarning = "Please enter a valid numeric amount.";
        }
    }

    private void ToggleChipSelection(string value)
    {
        if (_selectedAmount == value)
        {
            _selectedAmount = null;
            _debitAmount = string.Empty;
        }
        else
        {
            _selectedAmount = value;
            _debitAmount = value;
        }

        ValidateAmount();
    }

    private void SaveAutoDebitSettings()
    {
        if (string.IsNullOrWhiteSpace(_debitAmount))
        {
            Snackbar.Add("Please enter a debit amount.", Severity.Warning);
            return;
        }

        ValidateAmount();

        if (!string.IsNullOrWhiteSpace(_amountWarning))
        {
            Snackbar.Add(_amountWarning, Severity.Warning);
            return;
        }

        Snackbar.Add("Settings saved. You will receive an OTP via M-PESA to confirm debit authorization.", Severity.Success);
    }
}

<style>

    .mud-chip-selected {
        background-color: #e0f7fa;
        font-weight: bold;
        border: 2px solid #009688;
    }
</style>
