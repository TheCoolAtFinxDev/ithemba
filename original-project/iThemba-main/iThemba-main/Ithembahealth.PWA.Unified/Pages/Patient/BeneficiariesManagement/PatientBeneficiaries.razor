@page "/patient/savings/beneficiaries"
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Patient, Admin")]

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-3">
    <MudText Typo="Typo.h5" Class="mb-2">My Beneficiaries</MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-4">Add and manage beneficiaries for your IThemba Health Savings Plan.</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddNewBeneficiary">
            Add Beneficiary
        </MudButton>
    </MudPaper>

    @if (BeneficiariesList.Count == 0)
    {
        <MudAlert Severity="Severity.Info">You have not added any beneficiaries yet.</MudAlert>
    }
    else
    {
        @foreach (var beneficiary in BeneficiariesList)
        {
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <div class="d-flex justify-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle1">@beneficiary.FullName</MudText>
                        <MudText Typo="Typo.caption">Relationship: @beneficiary.Relationship</MudText><br />
                        <MudText Typo="Typo.caption">Phone: @beneficiary.Phone</MudText>
                    </div>
                    <div class="d-flex gap-2">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => EditBeneficiary(beneficiary)">
                            Edit
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => RemoveBeneficiary(beneficiary)">
                            Remove
                        </MudButton>
                    </div>
                </div>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<BeneficiaryModel> BeneficiariesList = new()
    {
        new BeneficiaryModel { FullName = "Lerato Mokoena", Relationship = "Daughter", Phone = "+266 6211 1234" },
        new BeneficiaryModel { FullName = "Mpho Mokoena", Relationship = "Spouse", Phone = "+266 5899 8765" }
    };

    private void AddNewBeneficiary()
    {
        NavigationManager.NavigateTo("/patient/savings/beneficiaries/add");
    }

    private void EditBeneficiary(BeneficiaryModel b)
    {
        NavigationManager.NavigateTo($"/patient/savings/beneficiaries/edit?name={Uri.EscapeDataString(b.FullName)}");
    }

    private void RemoveBeneficiary(BeneficiaryModel b)
    {
        BeneficiariesList.Remove(b);
    }

    private class BeneficiaryModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Relationship { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
    }
}
