@page "/patient/doctors"
@using Ithembahealth.PWA.Unified.Shared.Components
@attribute [Authorize(Roles = "Patient")]

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudText Typo="Typo.h5" GutterBottom="true">Browse Doctors</MudText>

    <!-- Search and Filters -->
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="SearchText" Label="Search by name" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Specialization" @bind-Value="SelectedSpecialty" Clearable="true">
                @foreach (var spec in Specializations)
                {
                    <MudSelectItem Value="@spec">@spec</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Location" @bind-Value="SelectedLocation" Clearable="true">
                @foreach (var loc in Locations)
                {
                    <MudSelectItem Value="@loc">@loc</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <!-- Doctor List -->
    @if (!PagedDoctors.Any())
    {
        <MudText Class="px-2 text-secondary">No doctors found matching your search.</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var doctor in PagedDoctors)
            {
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-3 mb-3" Elevation="2">
                        <MudGrid>
                            <MudItem xs="3">
                                <MudAvatar Image="@doctor.PhotoUrl" Size="Size.Large" />
                            </MudItem>
                            <MudItem xs="9">
                                <MudText Typo="Typo.subtitle1">@doctor.Name</MudText>
                                <MudText Typo="Typo.body2">@doctor.Specialization</MudText>
                                <MudText Typo="Typo.caption">@doctor.Location</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Fee: LSL @doctor.Fee</MudText>

                                <MudChip T="string" Color="@(doctor.IsAvailable? Color.Success: Color.Error)" Class="me-2" Size="Size.Small">
                                    @(doctor.IsAvailable ? "Available" : "Unavailable")
                                </MudChip>

                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                                           OnClick="() => BookDoctor(doctor)">
                                    Book Now
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        
    }
</MudContainer>
