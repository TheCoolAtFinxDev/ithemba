@page "/wallet/history"
@using System.Text
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Patient")]

<MudContainer Class="px-0 py-4" MaxWidth="MaxWidth.False">
    <MudText Typo="Typo.h5" Class="mb-2 px-4">Transaction History</MudText>
    <MudText Typo="Typo.subtitle2" Class="mb-4 px-4">All your wallet top-up transactions</MudText>

    <MudTextField @bind-Value="SearchText" Placeholder="Search by amount or status..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4 px-4" />

    <MudGrid Class="mb-4 px-4">
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Start Date" @bind-Date="StartDate" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="End Date" @bind-Date="EndDate" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end justify-between">
            <MudSelect T="string" Label="Filter by Status" @bind-Value="SelectedStatus" Clearable="true" Class="me-2">
                <MudSelectItem Value='@("Success")'>Success</MudSelectItem>
                <MudSelectItem Value='@("Failed")'>Failed</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportTransactions" Class="ms-2 px-3" Style="min-width: 100px;">
                Export
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (FilteredTopUps.Any())
    {
        <MudPaper Class="pa-2 mx-2" Style="max-height: 500px; overflow-y: auto;">
            <MudTable Items="FilteredTopUps"
                      ServerData="@(async (state, ct) => await LoadServerData(state))"
                      Bordered="false"
                      Dense="true"
                      Hover="true"
                      @bind-RowsPerPage="RowsPerPage"
                      @bind-CurrentPage="CurrentPage"
                      RowsPerPageOptions="new int[] { 5, 10, 20 }"
                      Breakpoint="Breakpoint.Sm">
                <RowTemplate>
                    <MudTd ColSpan="3">
                        <div class="d-flex justify-space-between align-center px-2 py-2">
                            <div class="d-flex flex-column">
                                <b>LSL @context.Amount</b>
                                <div class="text-secondary" style="font-size: 0.85rem;">Top-up for healthcare wallet</div>
                                <div class="text-caption">@RelativeTime(context.Timestamp)</div>
                            </div>
                            <MudChip T="string" Color="@(context.Status == "Success" ? Color.Success : Color.Error)" Variant="Variant.Filled">
                                @context.Status
                            </MudChip>
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" RowsPerPage="@RowsPerPage" @bind-Page="CurrentPage" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mx-4">
            No transactions found.
        </MudAlert>
    }

    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               OnClick="BackToWallet"
               Class="fixed-back-button">
        Back to Wallet
    </MudButton>

</MudContainer>


@code {
    private List<TopUpEntry> TopUpHistory = new();
    private string SearchText = string.Empty;
    private DateTime? StartDate;
    private DateTime? EndDate;
    private string SelectedStatus;
    private int CurrentPage { get; set; } = 0;
    private int RowsPerPage { get; set; } = 5;

    private List<TopUpEntry> FilteredTopUps =>
        TopUpHistory
            .Where(e =>
                (string.IsNullOrWhiteSpace(SearchText) || e.Amount.ToString().Contains(SearchText, StringComparison.OrdinalIgnoreCase) || e.Status.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) &&
                (!StartDate.HasValue || e.Timestamp.Date >= StartDate.Value.Date) &&
                (!EndDate.HasValue || e.Timestamp.Date <= EndDate.Value.Date) &&
                (string.IsNullOrWhiteSpace(SelectedStatus) || e.Status == SelectedStatus))
            .OrderByDescending(e => e.Timestamp)
            .ToList();

    private Task<TableData<TopUpEntry>> LoadServerData(TableState state)
    {
        var pagedData = FilteredTopUps
            .Skip(state.Page * state.PageSize)
            .Take(state.PageSize)
            .ToList();

        return Task.FromResult(new TableData<TopUpEntry>
        {
            Items = pagedData,
            TotalItems = FilteredTopUps.Count
        });
    }

    protected override void OnInitialized()
    {
        TopUpHistory = new List<TopUpEntry>
        {
            new TopUpEntry { Amount = 100, Timestamp = DateTime.Now.AddMinutes(-10), Status = "Success" },
            new TopUpEntry { Amount = 200, Timestamp = DateTime.Now.AddHours(-3), Status = "Success" },
            new TopUpEntry { Amount = 300, Timestamp = DateTime.Now.AddHours(-6), Status = "Failed" },
            new TopUpEntry { Amount = 120, Timestamp = DateTime.Now.AddHours(-12), Status = "Success" },
            new TopUpEntry { Amount = 180, Timestamp = DateTime.Now.AddDays(-1), Status = "Failed" },
            new TopUpEntry { Amount = 250, Timestamp = DateTime.Now.AddDays(-2), Status = "Success" },
            new TopUpEntry { Amount = 500, Timestamp = DateTime.Now.AddDays(-3), Status = "Failed" },
            new TopUpEntry { Amount = 90, Timestamp = DateTime.Now.AddDays(-4), Status = "Success" },
            new TopUpEntry { Amount = 340, Timestamp = DateTime.Now.AddDays(-5), Status = "Success" },
            new TopUpEntry { Amount = 410, Timestamp = DateTime.Now.AddDays(-6), Status = "Failed" }
        };
    }

    private string RelativeTime(DateTime timestamp)
    {
        var span = DateTime.Now - timestamp;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minute(s) ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hour(s) ago";
        return timestamp.ToString("dd MMM yyyy");
    }

    private void BackToWallet()
    {
        NavigationManager.NavigateTo("/patient/wallet");
    }

    private async Task ExportTransactions()
    {
        var csvBuilder = new StringBuilder();
        csvBuilder.AppendLine("Amount,Status,Date");

        foreach (var entry in FilteredTopUps)
        {
            csvBuilder.AppendLine($"{entry.Amount},{entry.Status},{entry.Timestamp:yyyy-MM-dd HH:mm}");
        }

        var csvContent = Encoding.UTF8.GetBytes(csvBuilder.ToString());
        var base64 = Convert.ToBase64String(csvContent);

        await JS.InvokeVoidAsync("downloadFile", $"WalletExport_{DateTime.Now:yyyyMMdd_HHmmss}.csv", base64);
        Snackbar.Add("Exported CSV downloaded", Severity.Success);
    }

    public class TopUpEntry
    {
        public int Amount { get; set; }
        public string Status { get; set; } = "Success";
        public DateTime Timestamp { get; set; }
    }
}
