@page "/admin/patients/{Id:guid}/savings"
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
    <MudText Typo="Typo.h5" GutterBottom="true">Health Savings Account</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Color="Color.Secondary">Account Holder</MudText>
                <MudText Typo="Typo.subtitle1">@Patient.FullName</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Color="Color.Secondary">Total Balance</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Success">LSL 1,800.00</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Color="Color.Secondary">Auto-Debit Enabled</MudText>
                <MudChip T="Color" Color="Color.Info" Size="Size.Small">Yes</MudChip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.subtitle1" Class="mb-2">Transactions</MudText>
    <MudTable Items="Transactions" Hover="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Amount</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("dd MMM yyyy")</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Amount" Class="text-right">LSL @context.Amount.ToString("F2")</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    public PatientRecord Patient = new()
    {
        FullName = "Lereko Mokoena"
    };

    public List<TransactionRecord> Transactions = new()
    {
        new() { Date = DateTime.Today.AddDays(-1), Type = "Deposit", Description = "Monthly Contribution", Amount = 300 },
        new() { Date = DateTime.Today.AddDays(-10), Type = "Claim", Description = "Clinic Visit", Amount = -150 },
        new() { Date = DateTime.Today.AddDays(-20), Type = "Deposit", Description = "Top-up", Amount = 200 }
    };

    public class TransactionRecord
    {
        public DateTime Date { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    public class PatientRecord
    {
        public string FullName { get; set; } = string.Empty;
    }
}
