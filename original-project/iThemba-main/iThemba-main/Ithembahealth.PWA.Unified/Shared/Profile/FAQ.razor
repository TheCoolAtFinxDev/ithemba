@page "/profile/faq"

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 px-3">
    <MudText Typo="Typo.h5" Class="mb-3">Frequently Asked Questions</MudText>

    <MudExpansionPanels>
        <MudExpansionPanel Text="How do I submit a health claim?">
            Navigate to the <strong>Claims</strong> section under Savings, click <em>Submit New Claim</em>, fill in the form, and attach your receipt or document.
        </MudExpansionPanel>

        <MudExpansionPanel Text="How long does it take to process a claim?">
            Most claims are reviewed within 2–5 business days. You'll be notified once your claim is approved or rejected.
        </MudExpansionPanel>

        <MudExpansionPanel Text="Can I add a beneficiary to my savings plan?">
            Yes, go to the <strong>Beneficiaries</strong> section under Savings and click <em>Add Beneficiary</em>. Make sure to include a valid phone number.
        </MudExpansionPanel>

        <MudExpansionPanel Text="How do I check my savings balance?">
            Your current balance is shown at the top of the <strong>Savings</strong> page.
        </MudExpansionPanel>

        <MudExpansionPanel Text="Who do I contact for urgent help?">
            Go to the <strong>Support</strong> page for call, email, or WhatsApp options.
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudContainer>
