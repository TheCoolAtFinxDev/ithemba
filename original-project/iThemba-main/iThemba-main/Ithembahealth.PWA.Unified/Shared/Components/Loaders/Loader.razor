@if (IsVisible)
{
    <div class="loader-overlay">
        <div style="text-align: center;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="loader-spinner" />
            <MudText Typo="Typo.subtitle1" Class="mt-2">@Message</MudText>
        </div>
    </div>
}

<style>
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    .loader-spinner {
        width: 80px;
        height: 80px;
    }
</style>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
}
